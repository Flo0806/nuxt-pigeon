{
  "name": "nuxt-pigeon",
  "version": "1.0.0-beta.1",
  "description": "Send and receive messages across Telegram, Slack, Discord and any webhook.",
  "keywords": [
    "bluesky",
    "discord",
    "mastodon",
    "messaging",
    "notifications",
    "ntfy",
    "nuxt",
    "nuxt-module",
    "slack",
    "telegram",
    "webhook"
  ],
  "homepage": "https://pigeon.fh-softdev.de",
  "bugs": {
    "url": "https://github.com/Flo0806/nuxt-pigeon/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flo0806/nuxt-pigeon.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "dev:docs": "pnpm --filter docs dev --port 3001",
    "docs:build": "pnpm --filter docs build",
    "docs:og": "pnpm --filter docs og",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.1",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.0",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.1",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.18.0"
}
